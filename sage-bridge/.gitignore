# Runtime secrets — NEVER commit
.env

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.pytest_cache/

# Virtual environments
.venv/
.venv-test/
venv/
env/

# Logs (rotating handler also produces .log.1 … .log.5)
logs/
*.log
*.log.*

# Durable outbox — contains undelivered business data.
# Must NOT be committed, and must NOT be deleted on a live install: it holds
# pending invoices and the scan watermark. Back it up separately.
data/
*.db
*.db-wal
*.db-shm
