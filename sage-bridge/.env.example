# ── Sage Bridge — Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.
#
# After creating .env, restrict it — it holds a shared secret in plaintext:
#   icacls .env /inheritance:r /grant:r "SYSTEM:(R)" /grant:r "Administrators:(F)"

# ── API security ─────────────────────────────────────────────────────────────
# Must match SAGE_BRIDGE_KEY in SynBot's backend/.env.
# The service REFUSES TO START if this is left as a placeholder or is <16 chars.
# Generate one with:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
BRIDGE_API_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET

# ── Sage 50 company file ─────────────────────────────────────────────────────
# Find via Sage 50 -> Help -> About Sage 50 Accounting -> data path.
# Typically one of:
#   C:\Sage\Peachtree\Company\ClientCompanyName\
#   C:\ProgramData\Sage\Peachtree\Company\ClientCompanyName\
SAGE_COMPANY_PATH=C:\Sage\Peachtree\Company\ClientCompanyName

# ── Sage SDK DLL ─────────────────────────────────────────────────────────────
# Standard Sage 50 2013 location (32-bit on 64-bit Windows).
# NOTE: the SDK needs a ONE-TIME interactive authorization inside Sage before
# it will open a session. See INSTALL.md section 3.4 — a service cannot answer
# that prompt, so it must be done by hand first.
SAGE_API_DLL_PATH=C:\Program Files (x86)\Sage\Peachtree\API\Sage.Peachtree.API.dll

# ── Pervasive ODBC ───────────────────────────────────────────────────────────
# Create a SYSTEM DSN using the 32-BIT administrator:
#   C:\Windows\SysWOW64\odbcad32.exe
# NOT the ODBC applet in Control Panel — that one is 64-bit and its DSNs are
# invisible to the 32-bit Python this bridge requires.
SAGE_ODBC_DSN=PervasiveSage50
# Full connection string (overrides the DSN when set):
# SAGE_ODBC_CONN_STR=Driver={Pervasive ODBC Client Interface};ServerName=localhost;DBQ=PervasiveSage50;
ODBC_TIMEOUT_SECONDS=30

# ── Bridge HTTP server ───────────────────────────────────────────────────────
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=7070
# CORS origins, comma-separated. Empty = none, which is correct for a
# server-to-server bridge. Do not set "*".
BRIDGE_CORS_ORIGINS=
# /docs and /redoc expose the full API surface unauthenticated. Off in
# production; turn on temporarily during setup if needed.
BRIDGE_ENABLE_DOCS=false

# ── SynBot webhook ───────────────────────────────────────────────────────────
# LAN IP of the machine running SynBot. VirtualBox must use a Bridged Adapter.
# Find it with `hostname -I` inside the VM.
SYNBOT_WEBHOOK_URL=http://UBUNTU_VM_LAN_IP/sage/webhook
# Must match SAGE_BRIDGE_WEBHOOK_SECRET in SynBot's backend/.env
SYNBOT_WEBHOOK_KEY=REPLACE_WITH_SAME_KEY_AS_SAGE_BRIDGE_WEBHOOK_SECRET

# ── TLS ──────────────────────────────────────────────────────────────────────
BRIDGE_CA_CERT_PATH=
# DIAGNOSTICS ONLY. Logs a warning on every startup while enabled.
BRIDGE_INSECURE_SKIP_VERIFY=false

# ── Watcher ──────────────────────────────────────────────────────────────────
# How often to check .DAT mtimes (cheap).
WATCHER_POLL_SECONDS=30
# Full invoice scan interval, run regardless of mtime. This is the safety net
# for Pervasive's unreliable mtime updates — do not raise it much.
WATCHER_FULL_SCAN_SECONDS=300
WATCHER_SCAN_PAGE_SIZE=100
WATCHER_MAX_PAGES_PER_TICK=20

# ── Outbox / retry ───────────────────────────────────────────────────────────
# Durable queue holding undelivered invoices and the scan watermark.
# BACK THIS UP. Do not delete it on a live install.
OUTBOX_DB_PATH=data/outbox.db
SENDER_POLL_SECONDS=5
SENDER_BATCH_SIZE=25
SENDER_TIMEOUT_SECONDS=30
# 20 attempts with the backoff below spans ~10h, so an overnight SynBot outage
# recovers without anyone touching it.
RETRY_MAX_ATTEMPTS=20
RETRY_BASE_SECONDS=2.0
RETRY_MAX_DELAY_SECONDS=3600
# Delivered events are purged after this many days. Pending and failed events
# are NEVER purged.
OUTBOX_RETAIN_SENT_DAYS=30

# ── Logging ──────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_FILE=logs/sage_bridge.log
LOG_MAX_BYTES=5000000
LOG_BACKUP_COUNT=5

# ── Mock mode ────────────────────────────────────────────────────────────────
# true  = run without Sage installed, using fake data (dev/demo/testing)
# false = live. Requires the company path, DSN and DLL above.
SAGE_MOCK=false
