# ── Sage Bridge — Environment Variables ──────────────────────────────────────
# Copy this file to .env and fill in real values.
# NEVER commit .env to source control.

# Shared API key — set the same value in SynBot's .env as SAGE_BRIDGE_KEY
# Must match SAGE_BRIDGE_KEY in backend/.env on the Ubuntu VM
BRIDGE_API_KEY=REPLACE_WITH_A_STRONG_RANDOM_SECRET

# ── Sage 50 Company File ──────────────────────────────────────────────────────
# TODO: Confirm the exact path on the client's Windows 7 machine.
# It will look something like one of these:
#   C:\Sage\Peachtree\Company\ClientCompanyName\
#   C:\Program Files\Sage Software\Peachtree\Company\ClientCompanyName\
#   C:\ProgramData\Sage\Peachtree\Company\ClientCompanyName\
# Ask the client to open Sage → Help → About, which shows the data path.
SAGE_COMPANY_PATH=C:\PLACEHOLDER\SageCompany\

# ── Sage SDK DLL ──────────────────────────────────────────────────────────────
# Standard Sage 50 2013 install location (32-bit on 64-bit Windows):
SAGE_API_DLL_PATH=C:\Program Files (x86)\Sage\Peachtree\API\Sage.Peachtree.API.dll

# ── Pervasive ODBC ────────────────────────────────────────────────────────────
# Create a System DSN in Windows ODBC Data Source Administrator pointing to
# the Sage company Pervasive database folder.  Name it exactly as below,
# OR provide a full connection string in SAGE_ODBC_CONN_STR.
SAGE_ODBC_DSN=PervasiveSage50
# Full conn string example (leave blank if using DSN):
# SAGE_ODBC_CONN_STR=Driver={Pervasive ODBC Client Interface};ServerName=localhost;DBQ=PervasiveSage50;

# ── Bridge HTTP Server ────────────────────────────────────────────────────────
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=7070

# ── SynBot Webhook ────────────────────────────────────────────────────────────
# The LAN IP of the Ubuntu VM running SynBot.
# VirtualBox must be set to Bridged Adapter mode so the VM gets a LAN IP.
# Example: http://192.168.1.105:8000/sage/webhook
SYNBOT_WEBHOOK_URL=http://UBUNTU_VM_LAN_IP:8000/sage/webhook
# Run `hostname -I` inside the Ubuntu VM to find its LAN IP
# Must match SAGE_BRIDGE_WEBHOOK_SECRET in backend/.env
SYNBOT_WEBHOOK_KEY=REPLACE_WITH_SAME_KEY_AS_SAGE_BRIDGE_WEBHOOK_SECRET

# ── Watcher ───────────────────────────────────────────────────────────────────
WATCHER_POLL_SECONDS=60

# ── Logging ───────────────────────────────────────────────────────────────────
LOG_LEVEL=INFO

# ── Mock Mode ─────────────────────────────────────────────────────────────────
# true  = Run without Sage installed. Returns realistic fake pharma data.
#         Use this for local testing and demos before the client site visit.
# false = Live mode. Requires SAGE_COMPANY_PATH, SAGE_ODBC_DSN, and the DLL.
#         Set this at the client site once you have the company path + DSN.
SAGE_MOCK=true
