# PlacewareBot — .env reference
# Copy this file to .env, then fill in the values marked <REPLACE>
# ─────────────────────────────────────────────────────────────────────────────

# ── Database (must match docker-compose.yml) ─────────────────────────────────
# For Docker Swarm stack deploys prefer placeware_db; db alias is also provided.
DATABASE_URL=postgresql://postgres:admin1234@placeware_db:5432/synbot_demo
POSTGRES_USER=postgres
POSTGRES_PASSWORD=admin1234
POSTGRES_DB=synbot_demo

# ── LLM (DeepSeek) ───────────────────────────────────────────────────────────
LLM_PROVIDER=deepseek
LLM_SERVICE_URL=https://api.deepseek.com/chat/completions
DEEPSEEK_API_KEY=<REPLACE — get from your Windows machine .env>
DEEPSEEK_MODEL=deepseek-chat

# ── Email (Gmail App Password) ────────────────────────────────────────────────
# Generate App Password: myaccount.google.com/apppasswords (2FA must be ON)
EMAIL_FROM=Warebot1@gmail.com
EMAIL_PASS=<REPLACE — Gmail App Password>
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587

# ── Termii — SMS/WhatsApp broadcast ──────────────────────────────────────────
TERMII_API_KEY=
TERMII_SENDER_ID=Placeware

# ── Auth & Security ───────────────────────────────────────────────────────────
# Regenerate for production: python -c "import secrets; print(secrets.token_hex(64))"
JWT_SECRET=7f3a9c2e14b85d06f1e7c3a84d2b9f56e8c1a7d3b5f2e94c6a1d8b3e7f9c205
# IMPORTANT: set DEV_TOKEN_ENABLED=0 in production — 1 bypasses all auth for dev
DEV_TOKEN_ENABLED=0
JWT_AUDIENCE=
RATE_LIMIT=60
WIDGET_SITE_KEYS=site_prod_abc123,site_staging_xyz789
WEBHOOK_SECRET=
AT_REST_KEY=

# ── Admin auto-seed (created on first startup) ────────────────────────────────
ADMIN_EMAIL=admin@placeware.com
ADMIN_PASSWORD=pware1234

# ── Sage 50 Bridge ────────────────────────────────────────────────────────────
# SAGE_MOCK=1  → use fake data, no Sage needed (safe for testing)
# SAGE_MOCK=0  → live mode, requires bridge running on Windows machine
SAGE_MOCK=1
# Replace with your Windows machine LAN IP (run `ipconfig` on Windows to find it)
SAGE_BRIDGE_URL=http://WINDOWS_DESKTOP_LAN_IP:7070
# Must match BRIDGE_API_KEY in sage-bridge/.env
SAGE_BRIDGE_KEY=placeware-bridge-dev-key-2026
# Must match SYNBOT_WEBHOOK_KEY in sage-bridge/.env
SAGE_BRIDGE_WEBHOOK_SECRET=placeware-webhook-secret-2026

# ── Google Places (Lead Finder CRM) ──────────────────────────────────────────
# Leave blank to use built-in mock data
GOOGLE_PLACES_API_KEY=

# ── Feature flags ─────────────────────────────────────────────────────────────
DEV_TOKEN_ENABLED=1
ENABLE_EXPIRY_MONITOR=0
SAGE_API_KEY=
LLM_API_KEY=

# ── Operational ───────────────────────────────────────────────────────────────
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=*
PG_EVENT_CHANNEL=event_bus

# ── Notifications ─────────────────────────────────────────────────────────────
WEEKLY_REPORT_RECIPIENTS=md@placeware.ng,sales@placeware.ng
WEEKLY_REPORT_ENABLED=1
EXECUTIVE_NOTIFY_EMAILS=ceo@placeware.ng,cfo@placeware.ng
