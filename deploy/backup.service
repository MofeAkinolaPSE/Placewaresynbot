[Unit]
Description=PlacewareBot daily PostgreSQL backup
After=docker.service
Requires=docker.service

[Service]
Type=oneshot
ExecStart=/bin/bash -lc 'for p in /opt/placeware/deploy/backup.sh /home/*/Placewaresynbot/deploy/backup.sh; do if [ -x "$p" ]; then exec /bin/bash "$p"; fi; done; echo "Backup script not found in expected paths."; exit 1'
StandardOutput=journal
StandardError=journal
SyslogIdentifier=placeware-backup
