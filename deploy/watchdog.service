[Unit]
Description=PlacewareBot Docker Container Watchdog
Documentation=https://github.com/MofeAkinolaPSE/Placewaresynbot
# Must start after docker is available
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
# Run as root because the watchdog executes Docker commands.
ExecStart=/bin/bash -lc 'for p in /opt/placeware/deploy/watchdog.sh /home/*/Placewaresynbot/deploy/watchdog.sh; do if [ -x "$p" ]; then exec /bin/bash "$p"; fi; done; echo "Watchdog script not found in expected paths."; exit 1'

# Restart the watchdog itself if it crashes
Restart=on-failure
RestartSec=10

# Send logs to journald (view with: journalctl -u placeware-watchdog -f)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=placeware-watchdog

# Give docker time to be ready before watchdog starts on boot
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
