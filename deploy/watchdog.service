[Unit]
Description=PlacewareBot Docker Container Watchdog
Documentation=https://github.com/MofeAkinolaPSE/Placewaresynbot
# Must start after docker is available
After=docker.service network-online.target
Requires=docker.service
Wants=network-online.target

[Service]
Type=simple
# Substitute the actual deploy user here (e.g. ubuntu, moe, etc.)
# To find your username: whoami
User=ubuntu

ExecStart=/home/ubuntu/Placewaresynbot/scripts/watchdog.sh

# Restart the watchdog itself if it crashes
Restart=on-failure
RestartSec=10

# Send logs to journald (view with: journalctl -u placeware-watchdog -f)
StandardOutput=journal
StandardError=journal
SyslogIdentifier=placeware-watchdog

# Give docker time to be ready before watchdog starts on boot
TimeoutStartSec=60

[Install]
WantedBy=multi-user.target
