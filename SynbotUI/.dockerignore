# ── Build artifacts (re-created inside the container) ───────────────────────
node_modules
dist
build
coverage
.nyc_output
.eslintcache

# ── Secrets and local environment files ─────────────────────────────────────
.env
.env.local
.env.development
.env.test
.env.production

# ── Version control ──────────────────────────────────────────────────────────
.git
.gitignore

# ── Editor / OS metadata ─────────────────────────────────────────────────────
.vscode
.idea
.cursor
.DS_Store
*.swp
*.swo
*~

# ── Log files ────────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ── Docker files (no need to copy these into the build context) ──────────────
Dockerfile
.dockerignore

# NOTE: pnpm-lock.yaml is intentionally NOT excluded here.
# It is required by `pnpm install --frozen-lockfile` in Stage 1 of the build.
